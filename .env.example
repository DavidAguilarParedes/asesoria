# Copia este archivo a .env y completa los valores. Nunca subas .env al repo.

LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_FAST_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# La SEC exige nombre y correo de contacto para descargas automáticas
SEC_USER_AGENT="Tu Nombre tu-correo@ejemplo.com"

# Cuenta de paper trading de Alpaca (dinero simulado)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true

# Tope de gasto por comando (se detiene si lo supera)
MAX_USD_PER_RUN=0.30

# --- Opcionales ---
# Servidor Qdrant. En Docker lo define docker-compose; sin él se usa la carpeta .qdrant
# QDRANT_URL=http://localhost:6333

# MLflow: trazas de cada conversación y registro de las evaluaciones.
# En Docker lo define docker-compose; sin él la app funciona igual, sin MLflow
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_UI_URL=http://localhost:5000
